{
  "name": "signal-form-showcase",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build signal-form-kit",
    "build:lib:prod": "ng build signal-form-kit --configuration=production",
    "publish:lib": "npm run test -- --no-watch && npm run build:lib:prod && npm publish ./dist/signal-form-kit --access public",
    "publish:lib:dry-run": "npm run build:lib:prod && npm publish ./dist/signal-form-kit --access public --dry-run",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.2.14",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "@playwright/test": "^1.60.0",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.2.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
